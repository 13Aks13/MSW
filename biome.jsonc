// Biome configuration for Minecraft Bedrock Management Platform
{
  "$schema": "https://biomejs.dev/schemas/2.1.2/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off"
      },
      "style": {
        "noParameterAssign": "warn",
        "useBlockStatements": "warn",
        "useShorthandArrayType": "warn"
      },
      "nursery": {
        "noUnusedVariables": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "attributePosition": "auto",
    "ignore": []
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignore": [
      "node_modules",
      ".pnpm-store",
      "dist",
      "build",
      "coverage",
      "*.tsbuildinfo",
      ".env",
      ".env.*",
      "data",
      "storage",
      ".DS_Store",
      ".idea",
      ".vscode",
      "test-results",
      "playwright-report",
      ".git",
      "pnpm-lock.yaml",
      "package.json",
      "package-lock.json",
      "yarn.lock"
    ]
  }
}
